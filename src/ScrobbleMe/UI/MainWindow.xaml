<!--
  Головне віконце «Зараз грає»: обкладинка, трек, прогрес до скроблу, статус.
  Відкривається з трею; хрестик не закриває застосунок, а ховає вікно в трей (див. MainWindow.xaml.cs).
  Розмір фіксований і невеликий — це інформер, а не повноцінний плеєр.
-->
<Window x:Class="ScrobbleMe.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScrobbleMe — Apple Music → last.fm"
        Width="400" SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="Manual"
        Background="#FAFAFA"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <!-- Нижня панель: обліковий запис і кнопка налаштувань -->
        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Налаштування" Padding="10,2" Click="OnSettingsClick"/>
                <TextBlock x:Name="AccountText" VerticalAlignment="Center" Foreground="#555" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="96" Height="96" CornerRadius="6" Background="#E6E6E6" ClipToBounds="True" VerticalAlignment="Top">
                <Grid>
                    <TextBlock x:Name="ArtPlaceholder" Text="&#x266A;" FontSize="40" Foreground="#AAA"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="ArtImage" Stretch="UniformToFill"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ArtistText" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="AlbumText" Margin="0,2,0,0" Foreground="#777" TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="ScrobbleProgress" Height="4" Margin="0,10,0,0" Minimum="0" Maximum="1"
                             Foreground="#D51007" Background="#E6E6E6" BorderThickness="0"
                             ToolTip="Скільки лишилося до скроблу"/>
                <TextBlock x:Name="StatusText" Margin="0,6,0,0" FontSize="12" Foreground="#555" TextWrapping="Wrap"/>
                <TextBlock x:Name="ErrorText" Margin="0,4,0,0" FontSize="12" Foreground="#C62828" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
