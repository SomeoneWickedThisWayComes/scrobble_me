<!--
  Вікно налаштувань: ключі last.fm API, вхід логіном/паролем, автозапуск.
  Відкривається з головного вікна або з меню трею. Логіка — SettingsWindow.xaml.cs.
-->
<Window x:Class="ScrobbleMe.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScrobbleMe — налаштування"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock Text="Ключі last.fm API" FontWeight="SemiBold" FontSize="14"/>
        <TextBlock Margin="0,4,0,8" TextWrapping="Wrap" Foreground="#555" FontSize="12">
            Одноразово: створіть «застосунок» на
            <Hyperlink NavigateUri="https://www.last.fm/api/account/create" RequestNavigate="OnLink">last.fm/api/account/create</Hyperlink>
            (назва будь-яка, Callback URL можна лишити порожнім) і скопіюйте сюди API key та Shared secret.
        </TextBlock>

        <TextBlock Text="API key"/>
        <TextBox x:Name="ApiKeyBox" Margin="0,2,0,8"/>
        <TextBlock Text="Shared secret"/>
        <PasswordBox x:Name="ApiSecretBox" Margin="0,2,0,12"/>

        <TextBlock Text="Обліковий запис last.fm" FontWeight="SemiBold" FontSize="14"/>
        <TextBlock x:Name="LoggedInText" Margin="0,4,0,8" Foreground="#2E7D32"/>

        <StackPanel x:Name="LoginPanel">
            <TextBlock Text="Логін"/>
            <TextBox x:Name="UserBox" Margin="0,2,0,8"/>
            <TextBlock Text="Пароль"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,2,0,4"/>
            <TextBlock Margin="0,0,0,8" FontSize="11" Foreground="#777" TextWrapping="Wrap"
                       Text="Пароль використовується лише для входу й ніде не зберігається."/>
        </StackPanel>

        <StackPanel Orientation="Horizontal">
            <Button x:Name="LoginButton" Content="Увійти" Padding="14,3" Click="OnLoginClick"/>
            <Button x:Name="LogoutButton" Content="Вийти з облікового запису" Padding="14,3" Margin="8,0,0,0" Click="OnLogoutClick"/>
        </StackPanel>
        <TextBlock x:Name="LoginError" Margin="0,6,0,0" Foreground="#C62828" TextWrapping="Wrap" Visibility="Collapsed"/>

        <CheckBox x:Name="AutostartBox" Content="Запускати разом з Windows (у треї)" Margin="0,16,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Зберегти" Padding="16,3" IsDefault="True" Click="OnSaveClick"/>
            <Button Content="Скасувати" Padding="16,3" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
